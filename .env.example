# Vercel Postgres(Storage 탭)에서 생성 후 자동으로 채워지는 값을 그대로 복사해서 사용하세요.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# 로그인 세션 암호화에 사용되는 임의의 문자열입니다. 터미널에서 openssl rand -base64 32 로 생성할 수 있습니다.
NEXTAUTH_SECRET="여기에-임의의-긴-문자열을-입력하세요"

# 배포된 사이트 주소 (Vercel이 자동으로 제공하는 도메인). 로컬 개발 시에는 http://localhost:3000
NEXTAUTH_URL="https://your-app.vercel.app"

